rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/owner)
        && get(/databases/$(database)/documents/settings/owner).data.uid == request.auth.uid;
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // الكتالوج: الضيف يشوف الظاهر بس، والأدمن يشوف ويعدّل كل حاجة
    match /products/{id} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }
    match /offers/{id} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }
    match /images/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // بيانات الأدمن الخاصة: سعر الشراء والمورد والتليفون والملاحظات
    match /privateProducts/{id} { allow read, write: if isAdmin(); }
    match /privateOffers/{id}   { allow read, write: if isAdmin(); }

    // صاحب التطبيق: أول حساب يعتمد نفسه، ومينفعش يتغيّر من التطبيق
    match /settings/owner {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'at']);
      allow update, delete: if false;
    }

    // المشرفين: صاحب التطبيق بس اللي يضيف ويشيل
    match /admins/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    // طلبات الإشراف: كل واحد يبعت طلبه لنفسه، وصاحب التطبيق يشوف ويوافق أو يرفض
    match /adminRequests/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }
  }
}
